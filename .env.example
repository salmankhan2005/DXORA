# ==============================================================================
# Automated Multi-Platform Posting System - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in the credentials for the platforms
# you wish to post to. Platforms without credentials will report a descriptive
# failure status unless SIMULATION_MODE is set to true.

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME="Automated Multi-Platform Posting System"
HOST=0.0.0.0
PORT=4000
DEBUG=false
REQUEST_TIMEOUT_SECONDS=10.0

# When true, platforms without live credentials simulate realistic successful posts.
# Set to false (default) in production to enforce real API authentication.
SIMULATION_MODE=false

# ------------------------------------------------------------------------------
# Platform 1: Telegram Bot API
# Docs: https://core.telegram.org/bots/api#sendmessage
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional public channel username (without @, e.g. dxora_announcements) for public URLs:
TELEGRAM_CHANNEL_USERNAME=

# ------------------------------------------------------------------------------
# Platform 2: Discord Webhook API
# Docs: https://discord.com/developers/docs/resources/webhook#execute-webhook
# ------------------------------------------------------------------------------
# Full webhook URL: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=
# Optional server/channel IDs for permalink generation if not part of webhook payload:
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_PUBLIC_ACCESS=false

# ------------------------------------------------------------------------------
# Platform 3: Mastodon API v1
# Docs: https://docs.joinmastodon.org/methods/statuses/#create
# ------------------------------------------------------------------------------
MASTODON_INSTANCE_URL=mastodon.social
MASTODON_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Platform 4: Twitter / X API v2
# Docs: https://developer.twitter.com/en/docs/twitter-api/tweets/manage-tweets/api-reference/post-tweets
# ------------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ------------------------------------------------------------------------------
# Platform 5: Slack Webhook / Web API
# Docs: https://api.slack.com/messaging/webhooks
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
